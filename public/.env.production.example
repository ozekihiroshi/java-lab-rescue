# Copy to .env.production. This file intentionally cannot start a deployment.
JAVA_LAB_HOST=java.example.org
MOODLE_ORIGIN=https://moodle.example.org
LTI_CLIENT_ID=REPLACE_WITH_MOODLE_CLIENT_ID
LTI_DEPLOYMENT_IDS=REPLACE_WITH_MOODLE_DEPLOYMENT_ID
# Build the existing hub/singleuser Dockerfiles, publish to your registry,
# then record RepoDigests here. Mutable tags are rejected by Hub configuration.
JAVA_HUB_IMAGE=registry.example.org/java-lab-hub@sha256:REPLACE_WITH_DIGEST
JAVA_SINGLEUSER_IMAGE=registry.example.org/java-lab-singleuser@sha256:REPLACE_WITH_DIGEST
# Set after capacity testing; each learner is limited to 3 GiB and one CPU.
JAVA_ACTIVE_SERVER_LIMIT=2
TRAEFIK_NETWORK=rescue_proxy
TRAEFIK_CERT_RESOLVER=myresolver
